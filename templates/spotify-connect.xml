<?xml version="1.0"?>
<Container version="2">
  <Name>spotify-connect</Name>
  <Repository>giof71/librespot:latest</Repository>
  <Network>br1</Network>
  <WebUI>https://open.spotify.com/</WebUI>
  <Icon>https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/spotify.png</Icon>
  <ExtraParams></ExtraParams>
  <Config Name="Spotify Device Name" Target="DEVICE_NAME" Default="Unraid Backyard" Mode="" Description="Spotify Connect device name" Type="Variable" Display="always" Required="true" Mask="false">Unraid Backyard</Config>
  <Config Name="Audio Backend" Target="BACKEND" Default="pipe" Mode="" Description="Pipe audio into Back-yard-EQ" Type="Variable" Display="always" Required="true" Mask="false">pipe</Config>
  <Config Name="Audio Pipe" Target="DEVICE" Default="/audio/spotify.pipe" Mode="" Description="Shared DSP audio pipe" Type="Variable" Display="always" Required="true" Mask="false">/audio/spotify.pipe</Config>
  <Config Name="Bitrate" Target="BITRATE" Default="320" Mode="" Description="Spotify bitrate" Type="Variable" Display="always" Required="true" Mask="false">320</Config>
  <Config Name="Initial Volume" Target="INITIAL_VOLUME" Default="75" Mode="" Description="Startup volume" Type="Variable" Display="always" Required="false" Mask="false">75</Config>
  <Config Name="Discovery Backend" Target="ZEROCONF_BACKEND" Default="libmdns" Mode="" Description="mDNS backend" Type="Variable" Display="always" Required="true" Mask="false">libmdns</Config>
  <Config Name="Discovery Port" Target="ZEROCONF_PORT" Default="24879" Mode="" Description="Discovery port" Type="Variable" Display="always" Required="true" Mask="false">24879</Config>
  <Config Name="Shared DSP Audio" Target="/audio" Default="/mnt/user/appdata/spotify-dsp/audio" Mode="rw" Description="Shared pipe folder" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/spotify-dsp/audio</Config>
  <Config Name="System Cache" Target="/data/system-cache" Default="/mnt/user/appdata/spotify-connect/system-cache" Mode="rw" Description="Spotify cache" Type="Path" Display="always" Required="false" Mask="false">/mnt/user/appdata/spotify-connect/system-cache</Config>
</Container>
